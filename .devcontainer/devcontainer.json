{
  "name": "Go Development Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "eamodio.gitlens",
        "GitHub.copilot",
        "redhat.vscode-yaml"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "go version && python3 --version && gh --version && go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"
}
